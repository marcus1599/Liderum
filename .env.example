# Liderum — Exemplo de Configuração de Variáveis de Ambiente
# Copie este arquivo para .env no desenvolvimento local (NÃO COMMITAR O ARQUIVO .env)

# Configuração de Segurança (JWT)
# Em produção, defina uma chave segura de no mínimo 32 bytes (256 bits) de alta entropia.
JWT_SECRET=<defina-um-segredo-aleatorio-com-pelo-menos-32-bytes>
JWT_EXPIRATION=604800000

# Ambiente e CORS (Compose executa o profile dev explicitamente)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Configuração de Mensageria (RabbitMQ)
RABBITMQ_ADDRESSES=amqp://<username>:<password>@<host>:<port>

# Configuração de Banco de Dados (Produção)
DB_URL=jdbc:postgresql://<host>:<port>/<database>
DB_USERNAME=<username>
DB_PASSWORD=<password>
